<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#E60D1117"
    android:padding="32dp">

    <!-- Lock Icon -->
    <ImageView
        android:id="@+id/ivLockIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_lock"
        app:tint="@color/red"/>

    <!-- App Name -->
    <TextView
        android:id="@+id/blockedAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="App Name"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:gravity="center"/>

    <!-- Status Badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BLOCKED"
        android:textColor="@color/red"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/badge_blocked"
        android:layout_marginTop="8dp"/>

    <!-- Explanation Message -->
    <TextView
        android:id="@+id/blockedMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This app is blocked during your attendance session. Clock out in FocusGuard to access it."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>

    <!-- Go Back Button -->
    <Button
        android:id="@+id/btnGoBack"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="GO BACK"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/rounded_button"
        android:layout_marginTop="40dp"/>

</LinearLayout>
